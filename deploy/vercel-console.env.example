# ============================================================
# VERCEL — octa-console  (the teacher/admin console)
# Paste into: Project → Settings → Environment Variables → Import .env
# Apply to: Production, Preview, Development. THEN REDEPLOY.
#
# ALSO: Settings → Deployment Protection → set Vercel Authentication to
# "Disabled" (or "Only Preview Deployments"). While it is on, the console
# redirects to vercel.com/login and NO instructor can reach it — only
# someone signed into the Vercel team account.
#
# And use the PRODUCTION domain, not a preview URL. A hostname carrying a
# deployment hash (octa-console-<hash>-<team>.vercel.app) changes on every
# deploy and is not a stable address to hand anyone.
# ============================================================

VITE_API_URL=https://REPLACE-ME.onrender.com
VITE_SUPABASE_URL=https://lqvkqdaqtkhxmnvodmyr.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE-ME

# Where the console links back to the student app.
VITE_WEB_URL=https://octa-web-beige.vercel.app
