# ============================================================
# VERCEL — octa-web  (the student app)
# Paste into: Project → Settings → Environment Variables → Import .env
# Apply to: Production, Preview, Development
# THEN REDEPLOY. Vite inlines these at BUILD time; changing a variable
# without rebuilding changes nothing at all.
# ============================================================

# The Render API's public base URL, with NO trailing slash.
# An EMPTY value is not the same as an unset one: `VITE_API_URL ?? "..."`
# only falls back on null/undefined, so "" makes every request resolve
# against the Vercel origin, where vercel.json's SPA catch-all returns
# index.html with HTTP 200 and the client parses HTML as JSON.
# That is the current state of the deployed build.
VITE_API_URL=https://REPLACE-ME.onrender.com

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://lqvkqdaqtkhxmnvodmyr.supabase.co

# Supabase → Project Settings → API Keys → anon / publishable.
# Safe in the browser bundle ONLY because RLS is correct; that is the whole
# bet, and services/api/test/rls.spec.ts is what backs it.
# NEVER put the service-role key in a VITE_* variable — Vite inlines it.
VITE_SUPABASE_ANON_KEY=REPLACE-ME

# Without BOTH Supabase values, apps/web/src/lib/session.ts returns a null
# client and the sign-in form answers
#   "Sign-in is not configured on this build. Ask your instructor."
# with no network request at all.
