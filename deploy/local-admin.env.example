# ============================================================
# YOUR OWN MACHINE — the one-time migration run
#
# NOT a hosting dashboard. These drive the scripts that push the schema, load
# the content and create the first admin, and every one of them runs from your
# laptop:
#
#   node scripts/db-push-supabase.mjs --check     # read-only, always run first
#   node scripts/db-push-supabase.mjs --reset     # DROPS the public schema
#   node scripts/sync-content.mjs
#   node scripts/sync-items.mjs
#   node scripts/sync-assessments.mjs
#   node scripts/bootstrap-admin.mjs
#
# Copy to deploy/local-admin.env (gitignored), fill in, then:
#   set -a; . deploy/local-admin.env; set +a
#
# DELETE IT when the migration is done. It holds the service-role key, which
# bypasses RLS completely.
# ============================================================

# Supabase → Project Settings → Data API
SUPABASE_URL=https://fdqnkxgyzdteckznefxx.supabase.co

# Supabase → Project Settings → API Keys → service_role / secret.
# Bypasses RLS. Never in a VITE_* variable, never on a frontend host.
SUPABASE_SERVICE_ROLE_KEY=REPLACE-ME

# Supabase → Connect → Session pooler (port 5432).
# The scripts run DDL and bulk inserts, which want a session connection.
# Render uses the TRANSACTION pooler on 6543 instead — different string, and
# the direct db.<ref>.supabase.co host is IPv6-only and does not resolve on
# every network, which reads as "the project is down" when it is not.

# BOTH names, same value, and this is not redundancy.
#   db-push-supabase.mjs reads SUPABASE_DB_SESSION
#   sync-*.mjs, bootstrap-admin.mjs and db-invariants.mjs read DATABASE_URL
# The push script also merges the ROOT .env underneath process.env, so leaving
# SUPABASE_DB_SESSION unset does not fail -- it silently falls through to
# whatever project the root .env describes. Measured 25 Sep 2026: --check
# reported the OLD project ref while every other variable pointed at the new
# one. A --reset in that state would have dropped the schema on the wrong
# database.
DATABASE_URL=postgresql://postgres.fdqnkxgyzdteckznefxx:REPLACE-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_SESSION=postgresql://postgres.fdqnkxgyzdteckznefxx:REPLACE-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- The first admin account -------------------------------------------
# Read by scripts/bootstrap-admin.mjs when you pass no arguments. Arguments
# still win; the env path exists so the password does not land in your shell
# history.
#
# THESE DEFAULTS ARE NOT SECRETS. They are committed in this file and printed
# to your terminal, so treat them as already seen. They are safe only because
# they cannot survive first contact:
#
#   - bootstrap-admin.mjs stamps app_metadata.must_change_credentials
#   - the console blocks on a change screen while that flag is set
#   - POST /console/account/credentials changes email AND password together
#     and clears the flag in the same call — never one without the other
#   - that route REFUSES either default (email case-insensitively), so they
#     cannot be submitted back to clear the flag
#
# Change them here before running if you would rather never have the defaults
# exist at all. Either way the instructor replaces both at first sign-in.
OCTA_ADMIN_EMAIL=admin@octa.local
OCTA_ADMIN_PASSWORD=OctaTemp-2026-change-me
OCTA_ADMIN_NAME=Course Administrator
