# ============================================================
# RENDER — octa-api  (services/api)
# Paste into: Service → Environment → Add from .env
#
# NODE_ENV, NODE_VERSION and ENGINE_VERSION are already set by render.yaml.
# They are repeated here so one paste produces a complete environment; setting
# them again is harmless. Everything marked REPLACE-ME is `sync: false` in
# render.yaml, which means it lives ONLY in the dashboard, never in the repo.
# ============================================================

NODE_ENV=production
NODE_VERSION=20.18.1
ENGINE_VERSION=1.0.0
JWT_AUDIENCE=authenticated

# ---- Supabase connection -----------------------------------------------
# MUST be the POOLER string on port 6543 (transaction mode), NOT the direct
# one. A free Render instance opening direct connections exhausts Supabase's
# limit under a class of forty. The direct host is also IPv6-only and does not
# resolve from every network.
#   Supabase → Connect → Transaction pooler
DATABASE_URL=postgresql://postgres.lqvkqdaqtkhxmnvodmyr:REPLACE-ME@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://lqvkqdaqtkhxmnvodmyr.supabase.co

# Supabase → Project Settings → API Keys.
# The service-role key bypasses RLS entirely. It belongs here and NOWHERE
# else — never in a VITE_* variable, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=REPLACE-ME
SUPABASE_ANON_KEY=REPLACE-ME

# Supabase → Project Settings → API → JWT Settings → JWT Secret.
# Needed to verify tokens. If SUPABASE_URL is set the API verifies via
# asymmetric JWKS instead, which is why a missing value here can look fine
# until it very suddenly does not.
SUPABASE_JWT_SECRET=REPLACE-ME

# ---- Secrets you generate yourself --------------------------------------
# Any long random string. Changing it re-seeds every future exam paper; it
# does NOT invalidate papers already generated, which are stored resolved.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXAM_SALT_SECRET=REPLACE-ME

# Shared secret for the Supabase pg_cron jobs that call this service.
# Render Free has no cron; every scheduled job is pg_cron + pg_net.
CRON_SECRET=REPLACE-ME

# Optional. Leave empty to disable error reporting.
SENTRY_DSN=

# ---- CORS ---------------------------------------------------------------
# BOTH Vercel origins, comma separated, NO trailing slashes and no paths.
# render.yaml calls a wrong value here "the most likely cause of it works
# locally and not deployed": the browser reports a CORS failure that looks
# exactly like the API being down.
CORS_ALLOWED_ORIGINS=https://octa-web-beige.vercel.app,https://REPLACE-ME-console.vercel.app

# ---- First admin account ------------------------------------------------
# Read by scripts/bootstrap-admin.mjs when you do not pass arguments.
# Run it ONCE, from your own machine, AFTER the schema push — a push with
# --reset drops the public schema and would delete the account.
#
#   node scripts/bootstrap-admin.mjs
#
# These are DEFAULTS, not secrets: they are committed here and printed to a
# terminal, so treat them as already seen. The account is stamped
# `app_metadata.must_change_credentials`, the console blocks on a change
# screen at first sign-in, and the API refuses to clear that flag while
# either value is still the default — so the first thing the instructor does
# is replace BOTH the email and the password.
OCTA_ADMIN_EMAIL=admin@octa.local
OCTA_ADMIN_PASSWORD=OctaTemp-2026-change-me
OCTA_ADMIN_NAME=Course Administrator
