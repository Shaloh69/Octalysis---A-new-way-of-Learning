# ============================================================
# apps/web — the STUDENT app. Vercel.
#
# EVERY VARIABLE HERE IS PUBLIC. Vite inlines each VITE_* value into the
# JavaScript bundle at build time, so anything below is readable by anyone who
# opens devtools. Putting a secret here publishes it.
#
# `pnpm check:env` fails the build if a server-only name ever appears with this
# prefix. It is not a style rule; it is the difference between a safe key and a
# leaked one.
# ============================================================

# The Fastify API on Render.
VITE_API_URL=http://localhost:8080

# Supabase project URL and the ANON key.
#
# The anon key is safe in the bundle ONLY because RLS is correct -- that is the
# whole bet this project rests on, and services/api/test/rls.spec.ts is the
# thing that keeps it honest (38 denial tests).
#
# THE SERVICE ROLE KEY NEVER GOES HERE. It bypasses RLS entirely.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# There is no third variable here on purpose.
#
# An earlier draft listed VITE_WEB_URL with a comment claiming it pointed at
# the console. Nothing in apps/web reads it -- the "wrong app" redirect runs the
# other way, from the console to here, so the variable belongs in
# apps/console/.env.example and only there. Setting it in Vercel for this
# project would have no effect and would read as if it did.
