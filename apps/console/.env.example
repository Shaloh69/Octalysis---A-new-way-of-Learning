# ============================================================
# apps/console — the TEACHER console. Vercel.
#
# EVERY VARIABLE HERE IS PUBLIC — see the note in apps/web/.env.example.
#
# The console shows answer keys, so it is tempting to think it needs a stronger
# key. It does not, and must not have one: staff access is decided by the JWT
# on every request, verified against Supabase's JWKS in services/api, and
# enforced again by RLS underneath. A service-role key in this bundle would
# hand every one of those to anyone who opened the page.
# ============================================================

# 8090, not 8080. Port 8080 is commonly another project's Adminer on a developer
# machine -- it answers 200 with an HTML login page, so the port looks healthy
# while every API call fails. `pnpm dev:api` starts the API on 8090.
VITE_API_URL=http://localhost:8090

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where to send someone who signs in with a student account.
VITE_WEB_URL=http://localhost:5173
