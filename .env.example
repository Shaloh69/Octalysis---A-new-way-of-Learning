# ============================================================
# OCTA — services/api
# Copy to .env and fill in. NOTHING here may be prefixed for the client bundle:
# Vite inlines every client-prefixed variable into the browser at build time.
# ============================================================

NODE_ENV=development
PORT=8080

# Local Docker Postgres (pnpm db:up). Swap for the Supabase pooler in production.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/octa

# Master salt. Per-assessment salts derive from this; it is never stored in a
# table a client can read. Generate with:  openssl rand -hex 32
EXAM_SALT_SECRET=replace-me-with-at-least-thirty-two-characters

# Pins the solver registry. Must match attempts.engine_version to regenerate a paper.
ENGINE_VERSION=1.0.0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- required once a Supabase project exists ---------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=
# JWT_AUDIENCE=authenticated
# JWT_ISSUER=

# Authenticates Supabase Cron -> /internal/* calls
# CRON_SECRET=

# SENTRY_DSN=
